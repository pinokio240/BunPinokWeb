{
  "name": "bunpinokweb",
  "version": "0.4.1",
  "description": "Chrome-like desktop browser built on Electron + Bun",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "postinstall": "node scripts/patch-electron-chrome-extensions.js"
  },
  "author": "pinokio240",
  "license": "GPL-3.0",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-chrome-extensions": "^4.9.0",
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pinokio240.bunpinokweb",
    "productName": "BunPinokWeb",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "pages/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BunPinokWeb-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BunPinokWeb"
    }
  }
}
